# Brace placement: on its own line after a function, on the same line after a
# control statement. Everything else follows LLVM with a four-space indent.
Language: Cpp
BasedOnStyle: LLVM

IndentWidth: 4
ColumnLimit: 100
PointerAlignment: Left
ReferenceAlignment: Pointer
AccessModifierOffset: -4

BreakBeforeBraces: Custom
BraceWrapping:
    AfterFunction: true
    AfterControlStatement: Never
    AfterClass: false
    AfterStruct: false
    AfterEnum: false
    AfterUnion: false
    AfterNamespace: false
    AfterCaseLabel: false
    BeforeElse: false
    BeforeCatch: false
    BeforeWhile: false
    IndentBraces: false
    SplitEmptyFunction: true
    SplitEmptyRecord: true

AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false

SpaceAfterTemplateKeyword: false
AlwaysBreakTemplateDeclarations: Yes

# Sorted within three groups, blank line between them: C headers, then C++
# standard headers, then this project's. Regroup rewrites the blocks, so a header
# that leans on a transitive include rather than its own will stop compiling --
# which is the point, but it means the missing includes have to go in first.
SortIncludes: CaseSensitive
IncludeBlocks: Regroup
IncludeCategories:
    # <stdio.h>, <sys/stat.h>, <unistd.h>
    - Regex: '^<.*\.h>'
      Priority: 1
    # <cstdio>, <string>, <vector>
    - Regex: '^<.*>'
      Priority: 2
    # "fasta.h", "memory/ByteBuffer.hpp"
    - Regex: '.*'
      Priority: 3

KeepEmptyLinesAtTheStartOfBlocks: false
MaxEmptyLinesToKeep: 2
